# Copy to .env and fill in. Every variable the application reads is listed here.

# ---------------------------------------------------------------------------
# Database (Postgres with the pgvector extension)
# ---------------------------------------------------------------------------
# Note the DB_ prefix on host and port. Bare HOST/PORT are still accepted on a
# developer machine, but managed platforms (Render, Heroku, Cloud Run) inject
# PORT for the *web* listener -- using it for the database would point Postgres
# connections at the web port.
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netflix

# Connection pool sizing. DB_POOL_MAX is the ceiling on concurrent queries.
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=5

# ---------------------------------------------------------------------------
# Hugging Face Inference API (query embeddings, hosted reranking)
# ---------------------------------------------------------------------------
HF_TOKEN=
HF_TIMEOUT_SECONDS=10
EMBED_CACHE_SIZE=512

# Reranking. "hf" uses the hosted Inference API, "local" loads a cross-encoder
# into this process (requires `pip install -e '.[rerank]'` and real memory),
# "none" disables the stage. Reranking is best-effort: a failure falls back to
# the RRF ordering rather than failing the search.
RERANK_ENABLED=true
RERANK_BACKEND=hf
RERANK_MODEL_NAME=BAAI/bge-reranker-base
RERANK_LOCAL_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Search tuning
# ---------------------------------------------------------------------------
# Invariant: VECTOR_CANDIDATES / BM25_CANDIDATES >= RERANK_CANDIDATES >= MAX_TOP_K.
# Violating it silently truncates results; the app logs a warning at startup.
DEFAULT_TOP_K=10
MAX_TOP_K=100
VECTOR_CANDIDATES=150
BM25_CANDIDATES=150
RERANK_CANDIDATES=100
RRF_K=60
HYBRID_ALPHA=0.8

SEARCH_CACHE_SIZE=256
SEARCH_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# AI overview (Ollama)
# ---------------------------------------------------------------------------
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=ministral-3:8b-cloud
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_SECONDS=60

# Only the top N results are summarized -- each one costs input tokens.
AI_OVERVIEW_MAX_MOVIES=5
# Requests per minute per client IP for the (paid) AI overview path. 0 disables.
AI_OVERVIEW_RATE_LIMIT=10

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Extra allowed origins, comma separated. localhost:3000/3001 are always allowed.
CORS_ORIGINS=
LOG_LEVEL=INFO
